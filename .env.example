# Copy to .env for local development.

DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Auth modules shown on the login page, in order. Installed: dev, discord, tetrio.
# `dev` signs in as any username without a password and only works in `pnpm dev`.
AUTH_MODULES=dev
# Modules considered secure. Sessions from other modules can't open admin pages.
TRUSTED_AUTH_MODULES=dev

# Bracket themes organizers can pick. Installed: default, tetrio. Empty means all of them.
# BRACKET_THEMES=default,tetrio

# Discord OAuth2 app (https://discord.com/developers/applications), used by `discord` and `tetrio`.
# Add redirect URIs <origin>/auth/discord/callback and <origin>/auth/tetrio/callback.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Production only (adapter-node): the server takes its public URL from these proxy headers.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
